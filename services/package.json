{
	"name": "bee-epic-apiary-services",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "npx -y concurrently -n worker,stripe -c blue,magenta \"npm run dev:main\" \"npm run dev:webhooks\"",
		"dev:main": "wrangler dev --env development",
		"dev:webhooks": "npx -y @stripe/cli listen --forward-to localhost:8787/stripe/webhook",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"format": "npx -y prettier --write .",
		"format:staged": "npx -y pretty-quick --staged --no-restage --verbose",
		"lint": "npx -y eslint . --report-unused-disable-directives --max-warnings 0",
		"postinstall": "npm run cf-typegen",
		"cleanup:products": "node scripts/cleanup-unpriced-products.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.19",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^8.0.2",
		"@types/marked": "^5.0.2",
		"@types/node": "^25.9.1",
		"@types/stripe": "^8.0.416",
		"@vitest/coverage-istanbul": "^4.1.7",
		"globals": "^17.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vitest": "^4.1.7",
		"wrangler": "^4.121.0"
	},
	"dependencies": {
		"@bee-epic/shared": "file:../shared",
		"marked": "^18.0.5",
		"stripe": "^22.2.0",
		"zod": "^4.4.3"
	}
}
