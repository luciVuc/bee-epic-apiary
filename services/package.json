{
	"name": "bee-epic-apiary-services",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"format": "npx -y prettier --write .",
		"format:staged": "npx -y pretty-quick --staged --no-restage --verbose",
		"lint": "npx -y eslint . --report-unused-disable-directives --max-warnings 0",
		"postinstall": "npm run cf-typegen",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.10",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^8.0.2",
		"@types/node": "^25.9.1",
		"@types/stripe": "^8.0.416",
		"@vitest/coverage-istanbul": "^4.1.7",
		"globals": "^17.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vitest": "^4.1.7",
		"wrangler": "^4.95.0"
	},
	"dependencies": {
		"stripe": "^22.2.0",
		"zod": "^4.4.3"
	}
}
